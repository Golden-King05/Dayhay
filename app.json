{
  "expo": {
    "name": "Hay Day Optimizer",
    "slug": "dayhay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dayhay.optimizer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9EE"
      },
      "package": "com.dayhay.optimizer"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5C9E2E",
          "sounds": []
        }
      ]
    ],
    "scheme": "dayhay",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75e9efb2-114c-489c-9a76-d0298ddb8781"
    },
    "extra": {
      "eas": {
        "projectId": "75e9efb2-114c-489c-9a76-d0298ddb8781"
      }
    }
  }
}
